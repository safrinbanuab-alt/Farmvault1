# =========================================
# FarmVault Environment Configuration
# Copy this file to .env and fill in values
# =========================================

# --- Application ---
APP_NAME=FarmVault
APP_ENV=development           # development | staging | production
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-key
API_V1_PREFIX=/api

# --- Server ---
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./farmvault.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/farmvault

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL=30

# --- IoT Simulator ---
SENSOR_UPDATE_INTERVAL_SECONDS=5
MARKET_FEED_UPDATE_INTERVAL_SECONDS=30
ANOMALY_INJECTION_ENABLED=true
ANOMALY_INJECTION_PROBABILITY=0.05

# --- AI Models ---
DECAY_MODEL_PATH=app/data/decay_curves.csv
MANDI_PRICE_DATA_PATH=app/data/mandi_prices.csv
PRICE_FORECAST_HORIZON_DAYS=7

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/farmvault.log

# --- Auth (if enabled) ---
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
